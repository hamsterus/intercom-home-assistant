# Intercom package/configuration example
# Replace __...__ placeholders locally. Do not commit real credentials.

shell_command:
  intercom_snapshot: >
    curl -o /config/www/intercom/photos/{{ filename }}.jpg
    "http://__GO2RTC_USER__:__GO2RTC_PASSWORD__@__HA_HOST__:1984/api/frame.jpeg?src=bas_ip"

  intercom_save_call: >
    python3 /config/intercom_save_call.py
    '{{ id }}' '{{ time }}' '{{ timestamp }}' '{{ device }}'
    '{{ name }}' '{{ status }}' '{{ photo }}'

  intercom_clear_history: >
    rm -f /config/www/intercom/call_history.json;
    rm -f /config/www/intercom/photos/*.jpg;
    echo "[]" > /config/www/intercom/call_history.json

