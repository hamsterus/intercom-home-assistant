[internal]
; 9100 = Home Assistant SIP/WSS panel
; Replace __TABLET_IP__, __HA_URL__, and credentials locally.

exten => 9100,1,NoOp(INTERCOM CALL - 9100)
same => n,Set(FULLY_SCREEN_RESULT=${SHELL(curl -sS --max-time 2 "http://__TABLET_IP__:2323/?cmd=screenOn&password=__TABLET_API_PASSWORD__" >/dev/null 2>&1)})
same => n,Set(FULLY_RING_RESULT=${SHELL(curl -sS --max-time 3 "http://__TABLET_IP__:2323/?cmd=playSound&url=https%3A%2F%2F__HA_HOST__:8123%2Flocal%2Fdoorbell.mp3&loop=true&stream=4&password=__TABLET_API_PASSWORD__" >/dev/null 2>&1)})
same => n,Set(FULLY_JS_RESULT=${SHELL(curl -sS --max-time 2 "http://__TABLET_IP__:2323/?cmd=injectJavascript&code=window.IntercomSIPV2.forceRegister%28%29&password=__TABLET_API_PASSWORD__" >/dev/null 2>&1)})
same => n,Set(WAIT_COUNT=0)
same => n,While($[${WAIT_COUNT} < 12])
same => n,Set(CONTACT_ID=${PJSIP_AOR(9100,contact)})
same => n,GotoIf($["${CONTACT_ID}" = ""]?wait_more)
same => n,Set(HA_STATUS=${PJSIP_CONTACT(${CONTACT_ID},status)})
same => n,GotoIf($["${HA_STATUS}" = "Reachable"]?sip_ready)
same => n,GotoIf($["${HA_STATUS}" = "Avail"]?sip_ready)
same => n(wait_more),Wait(1)
same => n,Set(WAIT_COUNT=$[${WAIT_COUNT}+1])
same => n,EndWhile()
same => n,Goto(wakeup_failed)
same => n(sip_ready),Set(FULLY_STOP_RESULT=${SHELL(curl -sS --max-time 2 "http://__TABLET_IP__:2323/?cmd=stopSound&password=__TABLET_API_PASSWORD__" >/dev/null 2>&1)})
same => n,Dial(PJSIP/9100,60)
same => n,Hangup()
same => n(wakeup_failed),Set(FULLY_STOP_RESULT=${SHELL(curl -sS --max-time 2 "http://__TABLET_IP__:2323/?cmd=stopSound&password=__TABLET_API_PASSWORD__" >/dev/null 2>&1)})
same => n,Hangup()
